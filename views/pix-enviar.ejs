<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><title>Enviar Pix</title>
    <style>
        body { margin: 0; background-color: #0b192c; font-family: Arial, sans-serif; color: #ffffff; padding: 20px; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .card { background-color: #112238; padding: 25px; border-radius: 16px; border: 1px solid #1e3a5f; width: 100%; max-width: 380px; box-sizing: border-box; }
        input { width: 100%; padding: 12px; margin-bottom: 15px; background-color: #0b192c; border: 1px solid #234876; border-radius: 8px; color: #fff; box-sizing: border-box; }
        button { background-color: #00d2ff; color: #0b192c; width: 100%; padding: 14px; border: none; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer; }
        .msg { font-size: 13px; color: #34d399; margin-bottom: 15px; text-align: center; }
        .voltar { display: block; text-align: center; margin-top: 15px; color: #00d2ff; text-decoration: none; font-size: 13px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Enviar Pix (GoatPay)</h2>
        <% if (locals.resultado) { %>
            <div class="msg"><%= resultado %></div>
        <% } %>
        <form action="/pix-enviar" method="POST">
            <label style="font-size:12px; color:#00d2ff;">Chave Pix</label>
            <input type="text" name="chave" placeholder="CPF, E-mail ou Telefone" required>
            <label style="font-size:12px; color:#00d2ff;">Valor (R$)</label>
            <input type="number" step="0.01" name="valor" placeholder="0,00" required>
            <button type="submit">Efetuar Transferência</button>
        </form>
        <a href="/fazer-login" onclick="event.preventDefault(); window.history.back();" class="voltar">← Voltar</a>
    </div>
</body>
</html>
