<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><title>Receber Pix - Pix Dinâmico</title>
    <style>
        body { margin: 0; background-color: #0b192c; font-family: Arial, sans-serif; color: #ffffff; padding: 20px; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .card { background-color: #112238; padding: 25px; border-radius: 16px; border: 1px solid #1e3a5f; width: 100%; max-width: 380px; box-sizing: border-box; text-align: center; }
        input { width: 100%; padding: 12px; margin-bottom: 15px; background-color: #0b192c; border: 1px solid #234876; border-radius: 8px; color: #fff; box-sizing: border-box; text-align: center; font-size: 16px; }
        button { background-color: #00d2ff; color: #0b192c; width: 100%; padding: 14px; border: none; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer; }
        .qr-box { background-color: #0b192c; padding: 15px; border-radius: 8px; word-break: break-all; font-size: 12px; color: #34d399; margin-top: 15px; border: 1px solid #234876; }
        .voltar { display: block; text-align: center; margin-top: 15px; color: #00d2ff; text-decoration: none; font-size: 13px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Receber Pix (Dinâmico)</h2>
        <p style="font-size:12px; color:#8fa3b8; margin-bottom:20px;">Informe o valor para gerar o código de recebimento</p>

        <form action="/pix-receber" method="POST">
            <label style="font-size:12px; color:#00d2ff; display:block; text-align:left; margin-bottom:6px;">Valor do Pix (R$)</label>
            <input type="number" step="0.01" name="valor" placeholder="0.00" required>
            <button type="submit">Gerar Pix Dinâmico</button>
        </form>

        <% if (locals.qrcode && qrcode) { %>
            <div class="qr-box">
                <strong>Código Copia e Cola:</strong><br>
                <%= qrcode %>
            </div>
        <% } %>

        <a href="/fazer-login" onclick="event.preventDefault(); window.history.back();" class="voltar">← Voltar</a>
    </div>
</body>
</html>
