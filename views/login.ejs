<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BANKING MD MASTER - Login</title>
    <style>
        body {
            margin: 0;
            background-color: #0b192c;
            font-family: Arial, sans-serif;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            padding: 20px;
        }
        .card {
            background-color: #112238;
            width: 100%;
            max-width: 380px;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            border: 1px solid #1e3a5f;
            text-align: center;
        }
        .logo-img {
            width: 70px;
            height: 70px;
            object-fit: contain;
            margin-bottom: 10px;
        }
        h2 { font-size: 18px; margin-bottom: 5px; color: #ffffff; }
        p.subtitle { font-size: 12px; color: #8fa3b8; margin-bottom: 20px; }
        .msg-sucesso { background-color: #065f46; color: #34d399; padding: 10px; border-radius: 6px; font-size: 12px; margin-bottom: 15px; }
        label { font-size: 12px; color: #00d2ff; display: block; text-align: left; margin-bottom: 6px; font-weight: bold; }
        input { width: 100%; padding: 12px; margin-bottom: 15px; background-color: #0b192c; border: 1px solid #234876; border-radius: 8px; color: #ffffff; font-size: 14px; box-sizing: border-box; }
        .btn-submit { background-color: #00d2ff; color: #0b192c; width: 100%; padding: 14px; border: none; border-radius: 8px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 5px; }
        .links-container {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 13px;
        }
        .links-container a {
            color: #00d2ff;
            text-decoration: none;
        }
        .links-container a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="card">
        <img src="/logo.png" alt="Logo" class="logo-img">
        <h2>BANKING MD MASTER</h2>
        <p class="subtitle">Acesse com seu CPF e senha</p>

        <% if (mensagem) { %>
            <div class="msg-sucesso"><%= mensagem %></div>
        <% } %>

        <form action="/fazer-login" method="POST">
            <label>CPF</label>
            <input type="text" name="cpf" placeholder="000.000.000-00" required>

            <label>Senha</label>
            <input type="password" name="senha" placeholder="Sua senha" required>

            <button type="submit" class="btn-submit">Entrar</button>
        </form>

        <div class="links-container">
            <a href="/cadastro">Não tem uma conta? <strong>Criar Conta</strong></a>
            <a href="https://wallet.goatpay.com.br/login" target="_blank">Esqueceu a senha?</a>
        </div>
    </div>
</body>
</html>
