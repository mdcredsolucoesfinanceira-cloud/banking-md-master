<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Extrato - MD MASTER</title>
    <style>
        body { margin: 0; background-color: #0b192c; font-family: Arial, sans-serif; color: #ffffff; padding: 20px; }
        h2 { font-size: 20px; color: #00d2ff; margin-bottom: 5px; }
        p.sub { font-size: 12px; color: #8fa3b8; margin-bottom: 20px; }
        .item-extrato {
            background-color: #112238;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid #1e3a5f;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .info-desc { font-size: 14px; font-weight: bold; margin-bottom: 4px; }
        .info-data { font-size: 11px; color: #8fa3b8; }
        .valor-entrada { color: #34d399; font-weight: bold; font-size: 15px; }
        .valor-saida { color: #f87171; font-weight: bold; font-size: 15px; }
        .btn-voltar { display: block; margin-top: 20px; text-align: center; color: #00d2ff; text-decoration: none; font-size: 14px; }
    </style>
</head>
<body>
    <h2>Extrato da Conta</h2>
    <p class="sub">Histórico garantido dos últimos 30 dias</p>

    <% if (extrato.length === 0) { %>
        <p style="text-align: center; color: #8fa3b8; margin-top: 40px;">Nenhuma transação nos últimos 30 dias.</p>
    <% } else { %>
        <% extrato.forEach(item => { %>
            <div class="item-extrato">
                <div>
                    <div class="info-desc"><%= item.descricao %></div>
                    <div class="info-data"><%= new Date(item.data).toLocaleDateString('pt-BR') %></div>
                </div>
                <div class="<%= item.tipo === 'entrada' ? 'valor-entrada' : 'valor-saida' %>">
                    <%= item.tipo === 'entrada' ? '+' : '-' %> R$ <%= Number(item.valor).toFixed(2) %>
                </div>
            </div>
        <% }) %>
    <% } %>

    <a href="/fazer-login" onclick="event.preventDefault(); window.history.back();" class="btn-voltar">← Voltar para Início</a>
</body>
</html>
