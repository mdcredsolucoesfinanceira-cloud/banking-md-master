<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carregando...</title>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #000000; 
            color: #ffffff; 
            display: flex; 
            flex-direction: column;
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
            animation: fadeIn 0.6s ease-out;
        }
        .container {
            text-align: center;
            width: 100%;
            max-width: 320px;
            padding: 20px;
        }
        .logo { 
            width: 200px; 
            max-height: 120px; 
            object-fit: contain;
            margin-bottom: 35px; 
        }
        .progress-bar-container {
            width: 100%;
            height: 6px;
            background: #121212;
            border-radius: 4px;
            overflow: hidden;
            border: 1px solid #262626;
            margin-bottom: 12px;
        }
        .progress-bar {
            width: 0%;
            height: 100%;
            background: #ffffff;
            transition: width 0.1s linear;
        }
        .percentage {
            font-size: 14px;
            color: #a1a1aa;
            font-weight: 600;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Exibe a logo centralizada -->
        <img src="/logo.png" alt="Logo" class="logo" id="logoImg">
        <div class="progress-bar-container">
            <div class="progress-bar" id="progressBar"></div>
        </div>
        <div class="percentage" id="percentageText">0%</div>
    </div>

    <script>
        // Caso a imagem demore ou dê erro ao carregar, exibe um texto alternativo elegante
        document.getElementById('logoImg').onerror = function() {
            this.style.display = 'none';
            let fallback = document.createElement('h1');
            fallback.innerText = "GOATPAY";
            fallback.style.color = "#ffffff";
            fallback.style.marginBottom = "35px";
            fallback.style.fontSize = "28px";
            fallback.style.letterSpacing = "2px";
            this.parentNode.insertBefore(fallback, this);
        };

        let duration = 6000; // 6 segundos
        let intervalTime = 60; 
        let steps = duration / intervalTime;
        let currentStep = 0;

        let timer = setInterval(() => {
            currentStep++;
            let percent = Math.floor((currentStep / steps) * 100);
            if (percent > 100) percent = 100;

            document.getElementById('progressBar').style.width = percent + '%';
            document.getElementById('percentageText').innerText = percent + '%';

            if (percent >= 100) {
                clearInterval(timer);
                window.location.href = '/cadastro';
            }
        }, intervalTime);
    </script>
</body>
</html>
