<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BANKING MD MASTER</title>
    <style>
        body {
            margin: 0;
            background-color: #0b192c;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
        }
        .logo-splash {
            width: 180px; /* Logo maior */
            height: 180px;
            object-fit: contain;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
        }
    </style>
</head>
<body>
    <img src="/logo.png" alt="Logo" class="logo-splash">

    <script>
        // Carrega por exatamente 5 segundos e vai para o Login
        setTimeout(function() {
            window.location.href = '/login';
        }, 5000);
    </script>
</body>
</html>
