<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carregando...</title>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #000000; 
            color: #ffffff; 
            display: flex; 
            flex-direction: column;
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
            animation: fadeIn 0.6s ease-out;
        }
        .container {
            text-align: center;
            width: 90%; /* Quase a tela toda */
            max-width: 600px; /* Limite para não ficar gigante em telas muito largas */
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .logo { 
            /* Aumentado drasticamente */
            width: 100%; 
            max-width: 450px; /* Tamanho máximo desejado da logo */
            height: auto; 
            object-fit: contain;
            margin-bottom: 50px; /* Mais espaço entre logo e barra */
            
            /* Filtro para garantir que imagens pretas fiquem visíveis se necessário */
            /* filter: brightness(0) invert(1); */ /* Descomente essa linha APENAS se sua logo for preta e sumir no fundo */
        }
        .progress-bar-container {
            width: 100%;
            height: 10px; /* Barra um pouco mais grossa */
            background: #1a1a1a;
            border-radius: 5px;
            overflow: hidden;
            border: 1px solid #333333;
            margin-bottom: 15px;
        }
        .progress-bar {
            width: 0%;
            height: 100%;
            background: #ffffff;
            transition: width 0.1s linear;
        }
        .percentage {
            font-size: 16px; /* Texto maior */
            color: #a1a1aa;
            font-weight: 600;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
    <div class="container">
        <img src="/logo.png" alt="Logo" class="logo" id="logoImg">
        <div class="progress-bar-container">
            <div class="progress-bar" id="progressBar"></div>
        </div>
        <div class="percentage" id="percentageText">0%</div>
    </div>

    <script>
        // Caso a imagem não exista, o texto de emergência aparece
        document.getElementById('logoImg').onerror = function() {
            this.style.display = 'none';
            let fallback = document.createElement('h1');
            fallback.innerText = "GOATPAY";
            fallback.style.color = "#ffffff";
            fallback.style.marginBottom = "50px";
            fallback.style.fontSize = "48px";
            fallback.style.letterSpacing = "3px";
            this.parentNode.insertBefore(fallback, this);
        };

        let duration = 6000; 
        let intervalTime = 60; 
        let steps = duration / intervalTime;
        let currentStep = 0;

        let timer = setInterval(() => {
            currentStep++;
            let percent = Math.floor((currentStep / steps) * 100);
            if (percent > 100) percent = 100;

            document.getElementById('progressBar').style.width = percent + '%';
            document.getElementById('percentageText').innerText = percent + '%';

            if (percent >= 100) {
                clearInterval(timer);
                // Redireciona após os 6s
                window.location.href = '/cadastro';
            }
        }, intervalTime);
    </script>
</body>
</html>
